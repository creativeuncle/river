generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A support staff member who logs into the agent dashboard.
model Agent {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  title        String?
  role         String   @default("Agent")
  createdAt    DateTime @default(now())

  conversations Conversation[]
  messages      Message[]
}

enum ConversationStatus {
  OPEN
  CLOSED
}

// One customer's chat thread, started anonymously from the widget.
// A visitor is identified only by a client-generated id (stored in
// their browser's localStorage) — no account/login required to chat.
model Conversation {
  id         String             @id @default(uuid())
  visitorId  String
  visitorName  String?
  visitorEmail String?
  status     ConversationStatus @default(OPEN)
  assignedAgentId String?
  assignedAgent   Agent?         @relation(fields: [assignedAgentId], references: [id], onDelete: SetNull)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  messages Message[]

  @@index([visitorId])
  @@index([status, updatedAt])
}

enum SenderType {
  CUSTOMER
  AGENT
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderType     SenderType
  agentId        String?
  agent          Agent?       @relation(fields: [agentId], references: [id], onDelete: SetNull)
  text           String
  attachmentUrl  String?
  attachmentName String?
  readByAgent    Boolean      @default(false)
  readByVisitor  Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}
